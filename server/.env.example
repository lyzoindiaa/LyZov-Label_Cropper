PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/gst_tool
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=./uploads

# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
# For testing use rzp_test_* keys; for live use rzp_live_* keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
